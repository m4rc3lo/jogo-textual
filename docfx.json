{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "JogoTextual/JogoTextual.csproj"
          ],
          "src": "src"
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net9.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "toc.yml"
        ]
      },
      {
        "files": [
          "**.md"
        ],
        "src": "docs"
      },
      {
        "files": [
          "api/**.yml"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Jogo Textual",
      "_appTitle": "Lógica de Programação",
      "_enableSearch": true
    }
  }
}
